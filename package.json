  "version": "1.3.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "check:lib-imports": "node scripts/check-lib-imports.mjs",
    "sync:npm-package": "powershell -ExecutionPolicy Bypass -File scripts/sync-npm-package-from-dev.ps1",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "chromatic": "chromatic --project-token=chpt_b806ec8e42ec4c6",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "md": "tsx scripts/gen-md.ts"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.1.2",
